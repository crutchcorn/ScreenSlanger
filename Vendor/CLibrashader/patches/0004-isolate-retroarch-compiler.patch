+            .begin_function(void, None, spirv::FunctionControl::NONE, function_type)
+            .unwrap();
+        builder.begin_block(None).unwrap();
+        builder.ret().unwrap();
+        builder.end_function().unwrap();
+        builder.entry_point(model, function, "main", []);
