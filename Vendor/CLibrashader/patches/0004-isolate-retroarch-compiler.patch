+//! Short-lived, GPU-independent GLSL compiler. Stdout is reserved for binary protocol output.
+
+use librashader_reflect::front::compile_wire::{compile_request, MAX_MESSAGE_BYTES};
+use std::io::{Read, Write};
+use std::process::ExitCode;
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+    let mut request = Vec::new();
+    std::io::stdin()
+        .lock()
+        .take((MAX_MESSAGE_BYTES + 1) as u64)
+        .read_to_end(&mut request)?;
+    if request.len() > MAX_MESSAGE_BYTES {
+        return Err("compiler request exceeds the size limit".into());
+    }
+    let response = compile_request(&request)?;
+    let mut stdout = std::io::stdout().lock();
+    stdout.write_all(&response)?;
+    stdout.flush()?;
+    Ok(())
+}
+
+fn main() -> ExitCode {
+    match run() {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("librashader-compiler: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
