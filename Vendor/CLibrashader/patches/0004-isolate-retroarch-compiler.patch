+    fn response(vertex: &[u32], fragment: &[u32]) -> Vec<u8> {
+        let mut bytes = header(RESPONSE_MAGIC, 1);
+        append_words(&mut bytes, vertex).unwrap();
+        append_words(&mut bytes, fragment).unwrap();
+        bytes
+    }
+
+    #[test]
