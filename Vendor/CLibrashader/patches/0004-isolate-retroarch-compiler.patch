+    fn screenslanger_mtl_filter_chain_create_with_compiler(
+        preset: *mut libra_shader_preset_t,
+        queue: PMTLCommandQueue,
+        options: *const MaybeUninit<filter_chain_mtl_opt_t>,
+        helper_path: *const c_char,
