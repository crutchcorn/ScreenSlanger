+#[cfg(test)]
+mod tests {
+    use super::compact_grayscale;
+
+    #[test]
+    fn grayscale_preserves_color_and_alpha() {
+        let mut bytes = vec![0, 0, 0, 255, 127, 127, 127, 128, 255, 255, 255, 0];
+        assert!(compact_grayscale(&mut bytes));
+        assert_eq!(bytes, [0, 255, 127, 128, 255, 0]);
+    }
+
+    #[test]
+    fn color_preserves_original_bytes() {
+        let original = vec![0, 0, 0, 255, 1, 2, 1, 255];
+        let mut bytes = original.clone();
+        assert!(!compact_grayscale(&mut bytes));
+        assert_eq!(bytes, original);
+    }
+}
