+/// Compact exact grayscale pixels in place; preserve color images byte-for-byte.
+fn compact_grayscale(bytes: &mut Vec<u8>) -> bool {
+    if bytes.len() % 4 != 0 || !bytes.chunks_exact(4).all(|p| p[0] == p[1] && p[1] == p[2]) {
+        return false;
+    }
+    let pixels = bytes.len() / 4;
+    for index in 0..pixels {
+        bytes[index * 2] = bytes[index * 4];
+        bytes[index * 2 + 1] = bytes[index * 4 + 3];
+    }
+    bytes.truncate(pixels * 2);
+    true
+}
