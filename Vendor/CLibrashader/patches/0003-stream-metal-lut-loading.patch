+/// Disk grayscale images remain in their decoded layout until upload; all other
+/// formats use the existing RGBA8 conversion and BGRA swizzle.
+enum LutPixels {
+    Luma(Vec<u8>),
+    LumaAlpha(Vec<u8>),
+    Bgra(Vec<u8>),
+}
+
+struct DecodedLut {
+    size: Size<u32>,
+    pixels: LutPixels,
+}
+
+impl DecodedLut {
+    fn from_image(image: DynamicImage) -> Self {
+        let size = Size::new(image.width(), image.height());
+        let pixels = match image {
+            DynamicImage::ImageLuma8(image) => LutPixels::Luma(image.into_raw()),
+            DynamicImage::ImageLumaA8(image) => LutPixels::LumaAlpha(image.into_raw()),
+            image => {
+                let mut bytes = image.into_rgba8().into_raw();
+                BGRA8::convert(&mut bytes);
+                return Self::from_bgra(size, bytes);
+            }
+        };
+        Self { size, pixels }
+    }
+
+    fn from_bgra(size: Size<u32>, mut bytes: Vec<u8>) -> Self {
+        let pixels = if compact_grayscale(&mut bytes) {
+            LutPixels::LumaAlpha(bytes)
+        } else {
+            LutPixels::Bgra(bytes)
+        };
+        Self { size, pixels }
+    }
+}
 
